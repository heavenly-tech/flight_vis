{
  "name": "flight_vis",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "cargo run --manifest-path server-rs/Cargo.toml",
    "prebuild": "node scripts/build-egm96-grid.mjs",
    "brand:compose": "python3 branding/source/extract-chart-vector.py && python3 scripts/compose-brand-svgs.py",
    "brand:check": "python3 scripts/check-brand-land-iou.py",
    "export:icons": "python3 scripts/compose-brand-svgs.py && node scripts/export-icons.mjs",
    "build": "tsc --noEmit && vitest run && vite build",
    "lint": "tsc --noEmit && npm run lint:i18n && npm run lint:voseo",
    "lint:voseo": "vitest run src/i18n/voseoGuard.test.ts",
    "lint:i18n": "node scripts/i18n-check.mjs",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "preview": "vite preview",
    "start": "cargo run --release --manifest-path server-rs/Cargo.toml",
    "test": "cargo test --manifest-path server-rs/Cargo.toml"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/pngjs": "^6.0.5",
    "cesium": "^1.134.0",
    "egm96-universal": "^1.1.1",
    "jsdom": "^26.1.0",
    "pngjs": "^7.0.0",
    "to-ico": "^1.1.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.5",
    "vite-plugin-static-copy": "^3.1.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/outfit": "^5.3.0"
  }
}
