#[cfg(test)]
mod tests {
    use super::*;
    use crate::club::{
        auth::new_id,
        db::{now_ms, ClubDb},
        visibility::PilotRole,
        visibility::{FlightVisibility, Viewer},
    };
    use crate::live::LiveFix;

    fn second_club(db: &ClubDb, slug: &str) -> String {
        let id = new_id();
        db.
            conn.execute(
                "INSERT INTO clubs (id, name, slug, created_at, latitude, longitude, show_public_tracks)
                 VALUES ($1, $2, $3, $4, -33.0, -70.0, 1)",
                params![id, "Club B", slug, now_ms()],
            )
        
        .unwrap();
        id
    }

    #[test]
    fn club_show_public_off_hides_other_club_public() {
        let db = ClubDb::open_in_memory().unwrap();
        let club_a = db.default_club_id().unwrap();
        db.
            conn.execute(
                "UPDATE clubs SET latitude = -33.0, longitude = -70.0, show_public_tracks = 0 WHERE id = $1",
                params![club_a],
            )
        
        .unwrap();
        let club_b = second_club(&db, "club-b");
        db.upsert_type(&club_b, "C152").unwrap();
        db.upsert_aircraft(&club_b, "N-OUT", "C152", true).unwrap();
        let outsider = db
            .register(&club_b, "Out", "out@test", "", "password1234")
            .unwrap();
        db.approve_pilot(&outsider).unwrap();
        db.add_checkout(&outsider, "C152", None, None).unwrap();
        let dev = db.create_device(&outsider, "d").unwrap().0;
        db.issue_open_checkin(&outsider, &dev, &club_b, now_ms())
            .unwrap();
        let fid = db
            .start_flight(
                &outsider,
                &dev,
                "N-OUT",
                FlightVisibility::Public,
                false,
                now_ms(),
            )
            .unwrap();
        db.append_fix(
            &fid,
            &dev,
            &LiveFix {
                t: now_ms(),
                lat: -33.01,
                lon: -70.0,
                alt: Some(1500.0),
                alt_ref: Some("hae".into()),
                speed: None,
                course: None,
                accuracy: None,
            },
        )
        .unwrap();
        assert!(db.public_map().is_empty());
    }

    #[test]
    fn member_club_flight_unaffected_by_show_public_off() {
        let db = ClubDb::open_in_memory().unwrap();
        let club = db.default_club_id().unwrap();
        db.
            conn.execute(
                "UPDATE clubs SET latitude = -33.0, longitude = -70.0, show_public_tracks = 0 WHERE id = $1",
                params![club],
            )
        
        .unwrap();
        db.upsert_type(&club, "C152").unwrap();
        db.upsert_aircraft(&club, "N-M", "C152", true).unwrap();
        let member = db
            .register(&club, "Mem", "mem@test", "", "password1234")
            .unwrap();
        db.approve_pilot(&member).unwrap();
        db.add_checkout(&member, "C152", None, None).unwrap();
        let dev = db.create_device(&member, "d").unwrap().0;
        db.issue_open_checkin(&member, &dev, &club, now_ms())
            .unwrap();
        let fid = db
            .start_flight(
                &member,
                &dev,
                "N-M",
                FlightVisibility::Club,
                false,
                now_ms(),
            )
            .unwrap();
        db.append_fix(
            &fid,
            &dev,
            &LiveFix {
                t: now_ms(),
                lat: -33.01,
                lon: -70.0,
                alt: Some(1500.0),
                alt_ref: None,
                speed: None,
                course: None,
                accuracy: None,
            },
        )
        .unwrap();
        let viewer = Viewer::Pilot {
            id: member,
            status: PilotStatus::Approved,
            role: PilotRole::Pilot,
        };
        assert_eq!(db.club_map_for_viewer(&viewer).len(), 1);
    }
}

pub fn now_ms() -> i64 {
    std::time::SystemTime::now()
        .duration_since(std::time::UNIX_EPOCH)
        .map(|d| d.as_millis() as i64)
        .unwrap_or(0)
}

#[derive(Debug)]
pub enum RegisterError {
    WeakPassword,
    EmailExists,
    Hash,
    Db(#[allow(dead_code)] sqlx::Error),
}

#[derive(Debug)]
pub enum LoginError {
    Invalid,
}

#[derive(Debug, Clone, PartialEq, Eq)]
pub enum StartFlightError {
    NoTail,
    NotCleared { tail: String, type_code: String },
    NoCheckin,
    AlreadyActive,
    DeviceMismatch,
}

#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum CheckoutError {
    UnknownTail,
    UnknownType,
    Internal,
}

impl From<sqlx::Error> for CheckoutError {
    fn from(_: sqlx::Error) -> Self {
        Self::Internal
    }
}

#[derive(Debug, Clone, PartialEq, Eq)]
pub struct CheckinRecord {
    pub id: String,
    pub created_at: i64,
    pub expires_at: i64,
}

#[derive(Debug, Clone, PartialEq, Eq)]
pub enum CheckinReject {
    Format,
    ForgedHmac,
    OldStep,
    WrongClub,
    Replay,
}

#[derive(Debug, Serialize)]
pub struct DisplaySessionRow {
    pub id: String,
    pub label: String,
    pub created_at: i64,
    pub revoked: bool,
}

#[derive(Debug)]
pub enum PatchError {
    NotFound,
    Forbidden,
}

#[derive(Debug)]
pub enum EndError {
    NotFound,
    Forbidden,
    NotActive,
}

#[derive(Debug)]
pub enum DeleteError {
    NotFound,
    Forbidden,
    Db(#[allow(dead_code)] sqlx::Error),
}

#[derive(Clone, Serialize)]
pub struct TailInfo {
    pub id: String,
    pub tail: String,
    pub type_code: String,
}

#[derive(Clone, Serialize)]
pub struct DeviceInfo {
    pub id: String,
    pub label: String,
    pub created_at: i64,
}

#[derive(Clone, Serialize)]
pub struct TypeRow {
    pub id: String,
    pub code: String,
}

#[derive(Clone, Serialize)]
pub struct AircraftRow {
    pub id: String,
    pub tail: String,
    pub type_code: String,
    pub active: bool,
}

#[derive(Clone, Serialize)]
pub struct CheckoutRow {
    pub id: String,
    pub pilot_id: String,
    pub pilot_name: String,
    pub pilot_email: String,
    pub type_code: String,
    pub tail: Option<String>,
    pub expires_at: Option<i64>,
}

#[derive(Clone, Serialize)]
pub struct FlightSummary {
    pub id: String,
    pub tail: String,
    pub status: String,
    pub started_at: i64,
    pub ended_at: Option<i64>,
    pub visibility: String,
    pub show_pilot_name_public: bool,
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::club::visibility::{FlightVisibility, PilotRole, PilotStatus, Viewer};

    fn seed(db: &ClubDb) -> (String, String, String, String) {
        let club = db.default_club_id().unwrap();
        db.
            conn.execute(
                "UPDATE clubs SET public_altitude_mode = 'msl', public_altitude_min_ft = 0,
                 show_public_tracks = 1, public_radius_km = 500
                 WHERE id = ?1",
                params![club],
            )
        
        .ok();
        let type_id = db.upsert_type(&club, "C152").unwrap();
        let _ = type_id;
        let ac = db.upsert_aircraft(&club, "N123", "C152", true).unwrap();
        let pilot_a = db
            .register(&club, "Alice", "a@test", "L1", "password12")
            .unwrap();
        db.approve_pilot(&pilot_a).unwrap();
        let pilot_b = db
            .register(&club, "Bob", "b@test", "L2", "password12")
            .unwrap();
        db.approve_pilot(&pilot_b).unwrap();
        db.add_checkout(&pilot_a, "C152", None, None).unwrap();
        db.add_checkout(&pilot_b, "C152", None, None).unwrap();
        (club, pilot_a, pilot_b, ac)
    }

    fn pilot_device_with_checkin(db: &ClubDb, pilot_id: &str, club_id: &str) -> String {
        let dev = db.create_device(pilot_id, "phone").unwrap().0;
        db.issue_open_checkin(pilot_id, &dev, club_id, now_ms())
            .unwrap();
        dev
    }

    #[tokio::test]
    async fn wrong_type_checkout_blocks_tail() {
        let db = ClubDb::open_test().await.unwrap();
        let club = db.default_club_id().unwrap();
        db.upsert_type(&club, "DA20").unwrap();
        db.upsert_type(&club, "C152").unwrap();
        db.upsert_aircraft(&club, "N1", "C152", true).unwrap();
        let a = db.register(&club, "A", "a@test", "", "password12").unwrap();
        db.approve_pilot(&a).unwrap();
        db.add_checkout(&a, "DA20", None, None).unwrap();
        let tails = db.me_tails(&a, now_ms()).unwrap();
        assert!(tails.is_empty());
    }

    #[tokio::test]
    async fn checkout_expired_blocks_start() {
        let db = ClubDb::open_test().await.unwrap();
        let club = db.default_club_id().unwrap();
        db.upsert_type(&club, "C152").unwrap();
        db.upsert_aircraft(&club, "N123", "C152", true).unwrap();
        let a = db.register(&club, "A", "a@test", "", "password12").unwrap();
        db.approve_pilot(&a).unwrap();
        let expired = now_ms() - 1000;
        db.add_checkout(&a, "C152", None, Some(expired)).unwrap();
        let tails = db.me_tails(&a, now_ms()).unwrap();
        assert!(tails.is_empty());
    }

    #[tokio::test]
    async fn checkout_blocks_inactive_tail() {
        let db = ClubDb::open_test().await.unwrap();
        let club = db.default_club_id().unwrap();
        db.upsert_type(&club, "DA20").unwrap();
        db.upsert_aircraft(&club, "N999", "DA20", false).unwrap();
        let p = db.register(&club, "P", "p@test", "", "password12").unwrap();
        db.approve_pilot(&p).unwrap();
        db.add_checkout(&p, "DA20", None, None).unwrap();
        let tails = db.me_tails(&p, now_ms()).unwrap();
