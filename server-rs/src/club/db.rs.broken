        db.submit_checkin(&b, Some(&dev_b), &qr, t).unwrap();
        assert_eq!(
            db.start_flight(&b, &dev_a, "N123", FlightVisibility::Club, false, t),
            Err(StartFlightError::DeviceMismatch)
        );
    }

