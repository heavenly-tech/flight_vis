    pub async fn list_checkouts(&self) -> Vec<CheckoutRow> {
        {

            let mut stmt = conn.prepare(
                "SELECT c.id, c.pilot_id, p.name, p.email, t.code, a.tail, c.expires_at
                 FROM checkouts c
                 JOIN pilots p ON p.id = c.pilot_id
                 JOIN aircraft_types t ON t.id = c.type_id
                 LEFT JOIN aircraft a ON a.id = c.aircraft_id
                 ORDER BY p.email, t.code",
            )?;
            let rows = stmt.query_map([], |r| {
                Ok(CheckoutRow {
                    id: r.get(0)?,
                    pilot_id: r.get(1)?,
                    pilot_name: r.get(2)?,
                    pilot_email: r.get(3)?,
                    type_code: r.get(4)?,
                    tail: r.get(5)?,
                    expires_at: r.get(6)?,
                })
            })?;
            let mut out = Vec::new();
            for row in rows {
                out.push(row?);
            }
            Ok(out)
        
        .unwrap_or_default()
    }

    pub async fn pilot_club_id(&self, pilot_id: &str) -> Result<String, DbError> {
        {

            {
            let row = sqlx::query("SELECT club_id FROM pilots WHERE id = $1").bind(pilot_id).fetch_optional(&self.pool).await?;
            row.map(|row| -> Result<_, DbError> { let v0 = row.try_get::<_, String>(0)?;; let v1 = row.try_get::<_, String>(1)?;; let v2 = row.try_get::<_, String>(2)?;; Ok((v0, v1, v2)) }).transpose()
            
            .ok()
            .flatten()?;
        Some(row)
    }

    pub async fn list_display_sessions(&self, admin_id: &str) -> Vec<DisplaySessionRow> {
        {

            let mut stmt = conn.prepare(
                "SELECT id, label, created_at, revoked_at FROM display_sessions
                 WHERE created_by_pilot_id = $1 ORDER BY created_at DESC",
            )?;
            let rows = stmt.query_map(params![admin_id], |r| {
                let revoked_at: Option<i64> = r.get(3)?;
                Ok(DisplaySessionRow {
                    id: r.get(0)?,
                    label: r.get(1)?,
                    created_at: r.get(2)?,
                    revoked: revoked_at.is_some(),
                })
            })?;
            let mut out = Vec::new();
            for row in rows {
                out.push(row?);
            }
            Ok(out)
        
        .unwrap_or_default()
    }

    pub async fn display_map(&self, admin_creator_id: &str) -> Vec<TailLivePosition> {
        let club = self.pilot_club_id(admin_creator_id).unwrap_or_default(.await);
        let filter = self.club_map_filter(&club);
        let dem = self.dem_index();
        let rows = self.latest_map_fixes_global();
        let filtered: Vec<DeviceFix> = rows
            .into_iter()
            .filter(|r| {
                if self.pilot_is_approved_member(&r.pilot_id, &club) {
                    let vis =
                        FlightVisibility::parse(&r.visibility).unwrap_or(FlightVisibility::Club);
                    return matches!(vis, FlightVisibility::Club | FlightVisibility::Public);
                }
                filter.show_public_tracks
                    && crate::club::map_filter::visibility_is_public(&r.visibility)
                    && crate::club::map_filter::public_track_passes(r, &filter, &dem)
            })
            .collect();
        let mut positions = dedupe_by_tail(filtered);
        for pos in &mut positions {
            if let Some(f) = self.get_flight(&pos.flight_id) {
                if show_pilot_name(&Viewer::Anonymous, &f.pilot_id, f.show_pilot_name_public) {
                    pos.pilot_name = Some(f.pilot_name);
                } else {
                    pos.pilot_name = None;
                }
            }
        }
        let prefs = self.admin_map_tails(admin_creator_id.await);
        crate::club::map_filter::apply_public_cap(
            filter_admin_tails(positions, &prefs),
            filter.cap,
            (filter.center_lat, filter.center_lon),
        )
    }

    pub async fn seed_demo_if_empty(&self) -> Result<(), DbError> {
        let club_id = self.default_club_id()?;
        let exists: i64 = {

            conn.query_row(
                "SELECT COUNT(*) FROM pilots WHERE email = 'admin@demo.test'",
                [],
                |r| r.get(0),
            )
        ?;
        if exists > 0 {
            return Ok(());
        }
        let admin_id = new_id();
        let pilot_id = new_id();
        let pending_id = new_id();
        let hash = auth::hash_password("password12")
            .map_err(|_| DbError::InvalidParameterName("hash".into()))?;
        let t = now_ms();
        {

            conn.execute(
                "INSERT INTO pilots (id, club_id, name, email, license_no, status, role, password_hash, created_at) VALUES
                 ($1, $4, 'Demo Admin', 'admin@demo.test', 'ADM-1', 'approved', 'admin', $5, $6),
                 ($2, $4, 'Demo Pilot', 'pilot@demo.test', 'P-1', 'approved', 'pilot', $5, $6),
                 ($3, $4, 'Demo Pending', 'pending@demo.test', 'P-2', 'pending', 'pilot', $5, $6)",
                params![admin_id, pilot_id, pending_id, club_id, hash, t],
            )?;
            Ok(())
        ?;
        for code in ["DA20-C1", "C152"] {
            self.upsert_type(&club_id, code.await)?;
        }
        for tail in ["N101", "N202", "N303"] {
            self.upsert_aircraft(&club_id, tail, "C152", true.await)?;
        }
        self.add_checkout(&pilot_id, "C152", None, None)
            .map_err(|e| DbError::InvalidParameterName(format!("checkout: {e:?}")))?;
        self.add_checkout(&admin_id, "C152", None, None)
            .map_err(|e| DbError::InvalidParameterName(format!("checkout: {e:?}")))?;
        let (dev_pilot, _) = self.create_device(&pilot_id, "Pilot phone".await)?;
        let (dev_admin, _) = self.create_device(&admin_id, "Admin tablet".await)?;
        self.issue_open_checkin(&pilot_id, &dev_pilot, &club_id, t.await)?;
        self.issue_open_checkin(&admin_id, &dev_admin, &club_id, t.await)?;
        let seed_flight_err = |e: StartFlightError| {
            DbError::InvalidParameterName(format!("seed_demo flight: {e:?}"))
        };
        let pub_id = self
            .start_flight(
                &pilot_id,
                &dev_pilot,
                "N101",
                FlightVisibility::Public,
                true,
                t,
            )
            .map_err(seed_flight_err)?;
        let club_f = self
            .start_flight(
                &admin_id,
                &dev_admin,
                "N202",
                FlightVisibility::Club,
                false,
                t,
            )
            .map_err(seed_flight_err)?;
        let fix = |offset: i64, lat: f64| LiveFix {
            t: t + offset,
            lat,
            lon: -70.6,
            alt: Some(900.0),
            alt_ref: None,
            speed: Some(28.0),
            course: Some(120.0),
            accuracy: Some(6.0),
        };
        self.append_fix(&pub_id, &dev_pilot, &fix(100, -33.40).await)?;
        self.append_fix(&pub_id, &dev_pilot, &fix(200, -33.39).await)?;
        self.append_fix(&club_f, &dev_admin, &fix(150, -33.38).await)?;
        self.append_fix(&club_f, &dev_admin, &fix(250, -33.37).await)?;
        Ok(())
    }
    pub async fn club_checkin_window_hours(&self, club_id: &str) -> Result<i64, DbError> {
        let hours: i64 = {

            sqlx::query("SELECT checkin_window_hours FROM clubs WHERE id = $1").bind(club_id).fetch_optional(&self.pool).await
        
        .ok()
        .flatten()
    }

    pub async fn admin_extend_pilot_checkin(
        &self,
        admin_id: &str,
        pilot_id: &str,
        expires_at_ms: i64,
        now: i64,
    ) -> Result<CheckinRecord, ExtendCheckinError> {
        if expires_at_ms <= now {
            return Err(ExtendCheckinError::InvalidExpiry);
        }
        let (admin_club, admin_role) = self
            .
                {
            let row = sqlx::query("SELECT club_id, role FROM pilots WHERE id = $1").bind(admin_id).fetch_optional(&self.pool).await?;
            row.map(|row| -> Result<_, DbError> { let v0 = row.try_get::<_, String>(0)?;; let v1 = row.try_get::<_, String>(1)?;; Ok((v0, v1)) }).transpose()
                    .map_err(|_| StartFlightError::DeviceMismatch)?;
                if dev_owner.as_deref() != Some(pilot_id) {
                    return Err(StartFlightError::DeviceMismatch);
                }
                let checkin_club: String = conn
                    .query_row(
                        "SELECT club_id FROM checkins
                         WHERE outcome = 'ok' AND pilot_id = $1
                           AND expires_at IS NOT NULL AND expires_at > $2
                           AND (device_id IS NULL OR device_id = $3)
                         ORDER BY expires_at DESC LIMIT 1",
                        params![pilot_id, now, device_id],
                        |r| r.get(0),
                    )
                    .map_err(|_| StartFlightError::NoCheckin)?;
                let aircraft_id: Option<String> = conn
                    .query_row(
                        "SELECT id FROM aircraft WHERE tail = $1 AND club_id = $2 AND active = 1",
                        params![tail, checkin_club],
                        |r| r.get(0),
                    )
                    .optional()
                    .map_err(|_| StartFlightError::NoTail)?;
                let Some(aircraft_id) = aircraft_id else {
                    return Err(StartFlightError::NoTail);
                };
                let type_code: String = conn
                    .query_row(
                        "SELECT t.code FROM aircraft a
                         JOIN aircraft_types t ON t.id = a.type_id
                         WHERE a.id = $1",
                        params![aircraft_id],
                        |r| r.get(0),
                    )
                    .map_err(|_| StartFlightError::NoTail)?;
                if !ClubDb::checkout_ok(conn, pilot_id, &aircraft_id, now)
                    .map_err(|_| StartFlightError::NoTail)?
                {
                    return Err(StartFlightError::NotCleared {
                        tail: tail.to_string(),
                        type_code,
                    });
                }
                let pilot_active: i64 = conn
                    .query_row(
                        "SELECT COUNT(*) FROM flights WHERE pilot_id = $1 AND status = 'active'",
                        params![pilot_id],
                        |r| r.get(0),
                    )
                    .map_err(|_| StartFlightError::NoTail)?;
                if pilot_active > 0 {
                    return Err(StartFlightError::AlreadyActive);
                }
                let device_active: i64 = conn
                    .query_row(
                        "SELECT COUNT(*) FROM flights f
                         JOIN flight_devices fd ON fd.flight_id = f.id
                         WHERE fd.device_id = $1 AND f.status = 'active'",
                        params![device_id],
                        |r| r.get(0),
                    )
                    .map_err(|_| StartFlightError::NoTail)?;
                if device_active > 0 {
                    return Err(StartFlightError::AlreadyActive);
                }
                let club_id = checkin_club;
                let checkins: i64 = conn
                    .query_row(
                        "SELECT COUNT(*) FROM checkins
                         WHERE outcome = 'ok' AND pilot_id = $1 AND club_id = $2
                           AND expires_at IS NOT NULL AND expires_at > $3
                           AND (device_id IS NULL OR device_id = $4)",
                        params![pilot_id, club_id, now, device_id],
                        |r| r.get(0),
                    )
                    .map_err(|_| StartFlightError::NoCheckin)?;
                if checkins == 0 {
                    return Err(StartFlightError::NoCheckin);
                }
                let flight_id = new_id();
                conn.execute(
                    "INSERT INTO flights (id, pilot_id, aircraft_id, club_id, status, started_at, visibility, show_pilot_name_public)
                     VALUES ($1, $2, $3, $4, 'active', $5, $6, $7)",
                    params![
                        flight_id,
                        pilot_id,
                        aircraft_id,
                        club_id,
                        now,
                        visibility.as_str(),
                        show_pilot_name_public
                    ],
                )
                .map_err(|_| StartFlightError::NoTail)?;
                conn.execute(
                    "INSERT INTO flight_devices (flight_id, device_id) VALUES ($1, $2)",
                    params![flight_id, device_id],
                )
                .map_err(|_| StartFlightError::NoTail)?;
                Ok(flight_id)
            })();
            if outcome.is_ok() {
                conn.execute_batch("COMMIT")?;
            } else {
                let _ = conn.execute_batch("ROLLBACK");
            }
            Ok(())
        ;
        if db_err.is_err() {
            return Err(StartFlightError::NoTail);
        }
        outcome
    }
}

#[cfg(test)]
mod tests {
    use super::*;
    use crate::club::{
        db::{now_ms, ClubDb},
        visibility::FlightVisibility,
    };

    fn seed_with_window(db: &ClubDb, window_hours: i64) -> (String, String, String) {
        let club = db.default_club_id().unwrap();
        db.set_club_checkin_window_hours(&club, window_hours)
            .unwrap();
        let type_id = db.upsert_type(&club, "C152").unwrap();
        let _ = type_id;
        db.upsert_aircraft(&club, "N123", "C152", true).unwrap();
        let a = db
            .register(&club, "Alice", "a@test", "L1", "password12")
            .unwrap();
        db.approve_pilot(&a).unwrap();
        db.add_checkout(&a, "C152", None, None).unwrap();
        let dev = db.create_device(&a, "phone").unwrap().0;
        (club, a, dev)
    }

    #[test]
    fn window_hours_apply_to_new_checkin() {
        let db = ClubDb::open_in_memory().unwrap();
        let (club, a, dev) = seed_with_window(&db, 3);
        let t = 1_800_000_000_000_i64;
        let token = db.mint_checkin_qr_token(&club, t).unwrap();
        let rec = db.submit_checkin(&a, Some(&dev), &token, t).unwrap();
        assert_eq!(rec.expires_at, t + 3 * 3_600_000);
    }

    #[test]
    fn admin_extension_after_default_window() {
        let db = ClubDb::open_in_memory().unwrap();
        let (club, a, dev) = seed_with_window(&db, 1);
        let admin = db
            .register(&club, "Admin", "adm@test", "", "password12")
            .unwrap();
        db.
            conn.execute(
                "UPDATE pilots SET role = 'admin', status = 'approved' WHERE id = $1",
                params![admin],
            )
        
        .unwrap();
        let t = 2_000_000_000_000_i64;
        db.issue_open_checkin(&a, &dev, &club, t).unwrap();
        db.
            conn.execute(
                "UPDATE checkins SET expires_at = $1 WHERE pilot_id = $2",
                params![t + 30 * 60_000, a],
            )
        
        .unwrap();
        let after_window = t + 2 * 3_600_000;
        assert!(matches!(
            db.start_flight_atomic(
                &a,
                &dev,
                "N123",
                FlightVisibility::Club,
                false,
                after_window
            ),
            Err(StartFlightError::NoCheckin)
        ));
        let extended = after_window + 7 * 24 * 3_600_000;
        db.admin_extend_pilot_checkin(&admin, &a, extended, after_window)
            .unwrap();
        assert!(db
            .start_flight_atomic(
                &a,
                &dev,
                "N123",
                FlightVisibility::Club,
                false,
                after_window
            )
            .is_ok());
    }

    #[test]
    fn non_admin_cannot_extend_checkin() {
        let db = ClubDb::open_in_memory().unwrap();
        let (club, a, dev) = seed_with_window(&db, 2);
        let b = db
            .register(&club, "Bob", "b@test", "L2", "password12")
            .unwrap();
        db.approve_pilot(&b).unwrap();
        let t = now_ms();
        db.issue_open_checkin(&a, &dev, &club, t).unwrap();
        assert_eq!(
            db.admin_extend_pilot_checkin(&b, &a, t + 9_000_000, t),
            Err(ExtendCheckinError::Forbidden)
        );
    }

    #[test]
    fn two_starts_within_window_second_needs_end_first() {
        let db = ClubDb::open_in_memory().unwrap();
        let (club, a, dev) = seed_with_window(&db, 4);
        let t = now_ms();
        db.issue_open_checkin(&a, &dev, &club, t).unwrap();
        let f1 = db
            .start_flight_atomic(&a, &dev, "N123", FlightVisibility::Club, false, t)
            .unwrap();
        assert!(matches!(
            db.start_flight_atomic(&a, &dev, "N123", FlightVisibility::Club, false, t + 1),
            Err(StartFlightError::AlreadyActive)
        ));
        db.end_flight(&a, &f1, t + 2).unwrap();
        assert!(db
            .start_flight_atomic(&a, &dev, "N123", FlightVisibility::Club, false, t + 3)
            .is_ok());
    }
    #[allow(dead_code)]
    pub async fn count_devices_for_pilot(&self, pilot_id: &str) -> usize {
        {

            let n: i64 = sqlx::query("SELECT COUNT(*) FROM devices WHERE pilot_id = $1").bind(pilot_id).fetch_optional(&self.pool).await
                .map_err(|_| DeviceRegisterError::Db)?
            {
                conn.execute(
                    "UPDATE devices SET token_hash = $1, label = $2, model = $3 WHERE id = $4",
                    params![hash, label, model, existing_id],
                )
                .map_err(|_| DeviceRegisterError::Db)?;
                conn.execute(
                    "DELETE FROM device_pair_tokens WHERE device_id = $1",
                    params![existing_id],
                )
                .ok();
                return Ok(DeviceRegisterResponse {
                    id: existing_id,
                    token,
                    label: label.to_string(),
                    model: model.map(String::from),
                    install_id: Some(install_id.to_string()),
                    created: false,
                });
            }
            let count: i64 = conn
                .query_row(
                    "SELECT COUNT(*) FROM devices WHERE pilot_id = $1",
                    params![pilot_id],
                    |r| r.get(0),
                )
                .map_err(|_| DeviceRegisterError::Db)?;
            if count as usize >= MAX_DEVICES_PER_PILOT {
                return Err(DeviceRegisterError::CapExceeded);
            }
            let id = new_id();
            conn.execute(
                "INSERT INTO devices (id, pilot_id, token_hash, label, model, install_id, created_at)
                 VALUES ($1, $2, $3, $4, $5, $6, $7)",
                params![id, pilot_id, hash, label, model, install_id, now],
            )
            .map_err(|_| DeviceRegisterError::Db)?;
            Ok(DeviceRegisterResponse {
                id,
                token,
                label: label.to_string(),
                model: model.map(String::from),
                install_id: Some(install_id.to_string()),
                created: true,
            })
        })
    }

    fn end_active_flights_for_device(
        conn: &rusqlite::Connection,
        pilot_id: &str,
        device_id: &str,
        now: i64,
    ) -> rusqlite::Result<()> {
        let mut stmt = conn.prepare(
            "SELECT f.id FROM flights f
             INNER JOIN flight_devices fd ON fd.flight_id = f.id
             WHERE fd.device_id = $1 AND f.pilot_id = $2 AND f.status = 'active'",
        )?;
        let ids: Vec<String> = stmt
            .query_map(params![device_id, pilot_id], |r| r.get(0))?
            .filter_map(Result::ok)
            .collect();
        for flight_id in ids {
            conn.execute(
                "UPDATE flights SET status = 'ended', ended_at = $1 WHERE id = $2",
                params![now, flight_id],
            )?;
        }
        Ok(())
    }

    fn revoke_device_row(
        conn: &rusqlite::Connection,
        pilot_id: &str,
        device_id: &str,
    ) -> rusqlite::Result<bool> {
        let history: i64 = sqlx::query("SELECT COUNT(*) FROM flight_devices WHERE device_id = $1").bind(device_id).fetch_optional(&self.pool).await?;
            let Some(device_id) = device_id else {
                return Ok(false);
            };
            Self::end_active_flights_for_device(conn, pilot_id, &device_id, now_ms())?;
            Self::revoke_device_row(conn, pilot_id, &device_id)
        
    }

    pub async fn revoke_device_by_id(
        &self,
        pilot_id: &str,
        device_id: &str,
    ) -> Result<bool, DbError> {
        {

            Self::end_active_flights_for_device(conn, pilot_id, device_id, now_ms())?;
            Self::revoke_device_row(conn, pilot_id, device_id)
        
    }
}

#[cfg(test)]
mod tests {
    use crate::club::db::ClubDb;

    fn approved_pilot(db: &ClubDb) -> String {
        let club = db.default_club_id().unwrap();
        let id = db
            .register(&club, "P", "p@test", "L1", "password12")
            .unwrap();
        db.approve_pilot(&id).unwrap();
        id
    }

    #[test]
    fn register_returns_token_and_resolves() {
        let db = ClubDb::open_in_memory().unwrap();
        let pilot = approved_pilot(&db);
        let reg = db
            .register_device_for_install(
                &pilot,
                "Pixel 8",
                Some("Google Pixel 8"),
                "install-abc-12345",
            )
            .unwrap();
        assert!(reg.created);
        assert_eq!(
            db.resolve_device_token(&reg.token).as_deref(),
            Some(reg.id.as_str())
        );
        assert_eq!(db.device_pilot_id(&reg.id).as_deref(), Some(pilot.as_str()));
    }

    #[test]
    fn register_idempotent_same_install_id() {
        let db = ClubDb::open_in_memory().unwrap();
        let pilot = approved_pilot(&db);
        let a = db
            .register_device_for_install(&pilot, "Phone", None, "install-repeat-99")
            .unwrap();
        let b = db
            .register_device_for_install(&pilot, "Phone 2", None, "install-repeat-99")
            .unwrap();
        assert!(a.created);
        assert!(!b.created);
        assert_eq!(a.id, b.id);
        assert_ne!(a.token, b.token);
        assert!(db.resolve_device_token(&a.token).is_none());
        assert_eq!(
            db.resolve_device_token(&b.token).as_deref(),
            Some(a.id.as_str())
        );
    }

    #[test]
    fn revoke_by_install_removes_token() {
        let db = ClubDb::open_in_memory().unwrap();
        let pilot = approved_pilot(&db);
        let reg = db
            .register_device_for_install(&pilot, "X", None, "install-revoke-1")
            .unwrap();
        assert!(db
            .revoke_device_by_install(&pilot, "install-revoke-1")
            .unwrap());
        assert!(db.resolve_device_token(&reg.token).is_none());
    }
    pub async fn kiosk_qr_layout(&self, club_id: &str) -> Result<KioskQrLayoutRow, DbError> {
        {

            let row = sqlx::query("SELECT kiosk_qr_x, kiosk_qr_y, kiosk_qr_size, kiosk_layout_rev FROM clubs WHERE id = $1").bind(club_id).fetch_optional(&self.pool).await?;
            if needs.is_some() {
                let d = default_kiosk_qr_layout(DEFAULT_PREVIEW_ASPECT);
                conn.execute(
                    "UPDATE clubs SET kiosk_qr_x = $1, kiosk_qr_y = $2, kiosk_qr_size = $3 WHERE id = $4",
                    params![d.x, d.y, d.size, club_id],
                )?;
            }
            Ok(())
        
    }
}

#[cfg(test)]
mod tests {
    use crate::club::db::ClubDb;

    #[test]
    fn persistence_round_trip() {
        let db = ClubDb::open_in_memory().unwrap();
        let club = db.default_club_id().unwrap();
        db.ensure_kiosk_qr_defaults(&club).unwrap();
        let saved = db
            .set_kiosk_qr_layout(&club, 0.1, 0.15, 0.25, 16.0 / 9.0)
            .unwrap();
        assert_eq!(saved.size, 0.25);
        let read = db.kiosk_qr_layout(&club).unwrap();
        assert!((read.x - saved.x).abs() < 1e-9);
        assert_eq!(read.rev, saved.rev);
        let reset = db.reset_kiosk_qr_layout(&club, 16.0 / 9.0).unwrap();
        assert!(reset.rev > saved.rev);
    }
