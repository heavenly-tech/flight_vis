# App login password (never commit the real value).
# If unset, public slugs still render; upload/save stay locked.
FLIGHT_VIS_PASSWORD=

# Flight store directory. Default when unset: ./data
# FLIGHT_DATA=data

# Built frontend directory. Default when unset: ./dist
# FLIGHT_VIS_DIST=dist

# Listen port. Default when unset or invalid: 8080
# PORT=8080

# Comma-separated CIDRs of trusted reverse proxies. Only peers in these
# networks may set the login client IP via X-Real-IP / X-Forwarded-For.
# Default: 172.18.0.0/16,127.0.0.1/32,::1/128
# TRUSTED_PROXY_CIDRS=172.18.0.0/16,127.0.0.1/32,::1/128

# Optional Cesium ion token for the Vite globe.
# VITE_CESIUM_ION_TOKEN=
