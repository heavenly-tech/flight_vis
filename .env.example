# App login password (never commit the real value).
# If unset, public slugs still render; upload/save stay locked.
FLIGHT_VIS_PASSWORD=

# Flight store directory. Default when unset: ./data
# FLIGHT_DATA=data

# Built frontend directory. Default when unset: ./dist
# FLIGHT_VIS_DIST=dist

# Listen port. Default when unset or invalid: 8080
# PORT=8080

# Comma-separated CIDRs of trusted reverse proxies. Only peers in these
# networks may set the login client IP via X-Real-IP / X-Forwarded-For.
# Default: 172.18.0.0/16,127.0.0.1/32,::1/128
# TRUSTED_PROXY_CIDRS=172.18.0.0/16,127.0.0.1/32,::1/128

# Optional Cesium ion token for the Vite globe. Production CSP uses Esri terrain by default.
# VITE_CESIUM_ION_TOKEN=
# Set to 1 together with VITE_CESIUM_ION_TOKEN to use ion 3D terrain (requires CSP connect-src for ion).
# VITE_USE_CESIUM_ION_TERRAIN=

# Device tokens for live ingest (token=device name). Traccar Client uses id=<token> on /api/osmand.
# FLIGHT_VIS_DEVICE_TOKENS=hex-token-32chars-min=My Phone
# Or a file with one `token=name` or `token name` per line (comments with #).
# FLIGHT_VIS_DEVICE_TOKENS_FILE=/data/device-tokens.txt

# Android App Links: release signing cert SHA-256 (comma-separated, optional file ANDROID_CERT_SHA256_FILE).
# ANDROID_CERT_SHA256=AA:BB:CC:...

# Club registry Postgres (required in production). sqlx migrations run on startup.
# Shared heavenly PG 18.x; app role is NOSUPERUSER (`flightvis`). No PostGIS — only pgcrypto, uuid-ossp, etc. if your DBA installs them.
# DATABASE_URL=postgres://flightvis:secret@db.heavenly:5432/flight_vis
# DATABASE_URL_FILE=/run/secrets/database_url
# PGHOST=db.heavenly
# PGPORT=5432
# PGDATABASE=flight_vis
# PGUSER=flightvis
# PGPASSWORD=secret
# Legacy SQLite at {FLIGHT_DATA}/club.sqlite is imported once when Postgres is empty.
# FLIGHT_CLUB_NAME=Flight Club
# First admin (only created when email not already registered):
# FLIGHT_CLUB_BOOTSTRAP_ADMIN_EMAIL=
# FLIGHT_CLUB_BOOTSTRAP_ADMIN_PASSWORD=
# Demo users (admin/pilot/pending @demo.test, password12) for local screenshots:
# FLIGHT_CLUB_SEED_DEMO=1
# Optional fixed HMAC secret for kiosk check-in QR tokens:
# FLIGHT_CLUB_CHECKIN_SECRET=

# Club slug for single-club installs (kiosk /c/{slug} paths):
# FLIGHT_CLUB_SLUG=my-club
# Public base URL for magic links in email (no trailing slash):
# FLIGHT_CLUB_PUBLIC_URL=https://flight.heavenly.cl

# DEM tiles for server-side AGL public-track filter (not in git). Bilinear `.asc` grids named N{lat}W{lon}:
# scripts/fetch_dem_tiles.sh writes under {FLIGHT_DATA}/dem/
# Copernicus GLO-90 or SRTM; without tiles the server falls back to MSL for that fix.

# Postal SMTP (production from noreply@heavenly.cl):
# SMTP_HOST=postal-smtp
# SMTP_PORT=25
# SMTP_USER=
# SMTP_PASS=<postal-server-credential-key>
# Or read the password from a file (trailing newline trimmed; takes precedence over SMTP_PASS):
# SMTP_PASS_FILE=/run/secrets/smtp_pass
# SMTP_FROM=noreply@heavenly.cl

# Postal HTTP bounce webhook (`POST /api/webhooks/postal/bounce`, header `X-Postal-Signature-256`):
# POSTAL_WEBHOOK_PUBLIC_KEY_FILE=/run/secrets/postal-webhook-pub.pem